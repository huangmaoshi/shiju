# ====================================================================
# 拾句 · 环境变量配置示例（完整版）
# 复制此文件为 .env 后再修改：
#   docker compose up -d              # Docker 直接拉镜像部署
#   python run.py                     # 本地一键启动（后端 + 爬虫）
#   cd server && python run.py        # 本地单独启动后端
#
# 重要说明：
#   1. 这个文件应放在仓库根目录，命名为 .env
#   2. Docker Compose 会直接读取根目录 .env，并把变量注入到容器
#   3. server/.env 主要是历史本地开发文件，Docker 运行时不推荐依赖它
# ====================================================================

# --------------------------------------------------------------------
# 基础运行配置
# --------------------------------------------------------------------
PORT=6010
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# --------------------------------------------------------------------
# 认证 / 安全配置
# --------------------------------------------------------------------
JWT_SECRET=change_in_production
JWT_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_KEY=shiju_admin_key

# --------------------------------------------------------------------
# Docker 镜像配置（用于 compose 拉取 GHCR 镜像）
# --------------------------------------------------------------------
GHCR_OWNER=huangmaoshi
GHCR_TAG=latest

# --------------------------------------------------------------------
# 数据库配置
# --------------------------------------------------------------------
# 推荐：Docker 部署时使用 PostgreSQL（默认）
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/shiju

# 本地开发时可改为 SQLite（不设置或注释掉上面的 DATABASE_URL 即可回退）
# DATABASE_URL=sqlite:///data/dev.db

# PostgreSQL 连接参数（docker-compose 内 postgres 服务使用）
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=shiju

# 下面这些仅供本地开发或额外数据库切换参考
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shiju
# DATABASE_URL=postgresql://user:password@your-pg-host:5432/shiju
# DATABASE_URL=mysql://root:password@localhost:3306/shiju?charset=utf8mb4

# --------------------------------------------------------------------
# 微信 / 支付 / OSS（可选，按需填写）
# --------------------------------------------------------------------
WX_APP_ID=
WX_APP_SECRET=

WX_PAY_MCH_ID=
WX_PAY_API_KEY=
WX_PAY_NOTIFY_URL=http://localhost:6010/api/v1/member/pay/callback

OSS_REGION=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=shiju-bucket
OSS_ENDPOINT=
OSS_PUBLIC_DOMAIN=

# --------------------------------------------------------------------
# 广告 / 异步任务 / 日志（可选）
# --------------------------------------------------------------------
PANGOLIN_APP_ID=
PANGOLIN_AD_UNIT_SPLASH=
PANGOLIN_AD_UNIT_BANNER=
PANGOLIN_AD_UNIT_REWARD=

# --------------------------------------------------------------------
# AI 接入（可选：仅当你开启 AI 提取 / 拼音 / 繁转简 / 分类功能时需要）
# --------------------------------------------------------------------
# 若你使用 OpenAI 兼容协议大模型服务（例如 OpenAI / DeepSeek / Moonshot / 百炼等），
# 可以在后台管理页面中配置这些值；也可以先在这里写好默认值供服务读取。
AI_PROVIDER=OpenAICompatible
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --------------------------------------------------------------------
# 爬虫配置（可选：仅在使用 crawler 模块时需要）
# --------------------------------------------------------------------
CRAWL_LOG_LEVEL=debug
CRAWL_CONCURRENCY=2
CRAWL_TIMEOUT=30
CRAWL_MAX_RETRY=3
CRAWL_DELAY_MIN=1000
CRAWL_DELAY_MAX=3000
CRAWL_NO_SCHEDULE=0

# --------------------------------------------------------------------
# 前端本地开发端口
# --------------------------------------------------------------------
WEB_DEV_PORT=5173

# --------------------------------------------------------------------
# GHCR 镜像配置（Docker Compose 拉取镜像时使用）
# --------------------------------------------------------------------
GHCR_OWNER=huangmaoshi
GHCR_TAG=latest

# --------------------------------------------------------------------
# 额外说明
# --------------------------------------------------------------------
# 1) 如果你使用 Docker Compose 部署，建议把这里的变量复制到项目根目录的 .env。
# 2) 如果你直接运行 server/run.py，本地开发时也可以用这个根目录 .env；
#    代码会尝试自动加载它。
# 3) 如果不配置数据库，server/app/config.py 会自动回退到 server/data/dev.db。
# 4) 这个文件是示例文件，不要直接提交真实密钥；实际使用时请自行替换。
