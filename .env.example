# ====== 拾句 · 环境变量配置 ======
# 复制此文件为 .env，修改后执行 docker compose up -d --build

# 后端 JWT 密钥（生产务必修改）
JWT_SECRET=change_in_production

# JWT 过期时间
JWT_EXPIRES_IN=2h

# 管理后台鉴权密钥（登录时填写）
ADMIN_KEY=shiju_admin_key

# ===== MySQL 配置（可选，默认使用 SQLite）=====
# MYSQL_ROOT_PASSWORD=shiju_root_2024
# MYSQL_PASSWORD=shiju_pass_2024
