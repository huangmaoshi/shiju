# ====================================================================
# 拾句 · 环境变量配置
# 复制此文件为 .env，修改后执行：
#   docker compose up -d --build
#   或本地：npm run dev (在 server 目录)
# ====================================================================

# ---- 基础配置 ----
JWT_SECRET=change_in_production
JWT_EXPIRES_IN=2h
ADMIN_KEY=shiju_admin_key

# ====================================================================
# 端口配置
# ====================================================================
# 后端 API 端口
PORT=3000
# 管理后台前端端口（Vite dev server，仅本地开发使用）
WEB_DEV_PORT=5173
# PostgreSQL 端口（默认 5432，若冲突可修改）
PG_PORT=5432

# ====================================================================
# 数据库配置 （默认 PostgreSQL；如需 SQLite 请切换下方注释）
# ====================================================================

# ==================== PostgreSQL（当前启用，推荐） ====================
# 本地开发直连（本机已安装 PostgreSQL）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shiju?schema=public&connection_limit=10&pool_timeout=20"
# 使用 Docker 内的 PostgreSQL（替换 localhost 为 postgres）
# DATABASE_URL="postgresql://shiju:shiju_pass_2024@postgres:5432/shiju?schema=public"
# 远程 PostgreSQL
# DATABASE_URL="postgresql://user:password@your-pg-host:5432/shiju?schema=public"
PRISMA_SCHEMA="prisma/schema.postgres.prisma"

# PostgreSQL 连接参数
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=shiju

# ==================== SQLite（已禁用，如需使用请注释 PG、启用下方） ====================
# DATABASE_URL="file:./data/dev.db"
# PRISMA_SCHEMA="prisma/schema.prisma"

# ==================== MySQL（已禁用，如需使用请注释 PG、启用下方） ====================
# DATABASE_URL="mysql://root:password@localhost:3306/shiju?charset=utf8mb4"
# PRISMA_SCHEMA="prisma/schema.prisma"
# MYSQL_ROOT_PASSWORD=your_root_password
# MYSQL_PASSWORD=your_password
