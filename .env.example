# ====================================================================
# 拾句 · 环境变量配置（Python 版）
# 复制此文件为 .env，修改后执行：
#   docker compose up -d --build      # Docker 部署
#   python run.py                     # 本地一键启动（后端 + 爬虫）
#   cd server && python run.py        # 本地单独启动后端
# ====================================================================

# ---- 基础配置 ----
JWT_SECRET=change_in_production
JWT_EXPIRES_IN=2h
ADMIN_KEY=shiju_admin_key

# ====================================================================
# 端口配置
# ====================================================================
# 后端 API 端口
PORT=3000
# 管理后台前端端口（Vite dev server，仅本地开发使用）
WEB_DEV_PORT=5173
# PostgreSQL 端口（默认 5432，若冲突可修改）
PG_PORT=5432

# ====================================================================
# 数据库配置（默认 PostgreSQL；如需 SQLite 请切换下方注释）
# 注意：SQLAlchemy 连接串，不要带 Prisma 的 ?schema=public 等参数
# ====================================================================

# ==================== PostgreSQL（Docker 部署推荐） ====================
# 使用 Docker 内的 PostgreSQL（容器名 postgres）
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/shiju
# 本地开发直连（本机已安装 PostgreSQL）
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shiju
# 远程 PostgreSQL
# DATABASE_URL=postgresql://user:password@your-pg-host:5432/shiju

# PostgreSQL 连接参数（docker-compose 内 postgres 服务用）
PG_HOST=postgres
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=shiju

# ==================== SQLite（本地开发零配置，默认回退） ====================
# 不设 DATABASE_URL 时，server/app/config.py 会自动回退到 server/data/dev.db
# 如需显式指定：
# DATABASE_URL=sqlite:///data/dev.db

# ==================== MySQL（可选，需装 PyMySQL/MySQLdb 驱动） ====================
# DATABASE_URL=mysql://root:password@localhost:3306/shiju?charset=utf8mb4
# MYSQL_ROOT_PASSWORD=your_root_password
# MYSQL_PASSWORD=your_password
