# ====== 拾句 · 环境变量配置 ======
# 复制此文件为 .env，修改后执行 docker compose up -d --build

# 后端 JWT 密钥（生产务必修改）
JWT_SECRET=change_in_production

# JWT 过期时间
JWT_EXPIRES_IN=2h

# 管理后台鉴权密钥（登录时填写）
ADMIN_KEY=shiju_admin_key

# ====================================================================
# 数据库配置（默认 SQLite，可选 PostgreSQL）
# ====================================================================
# 默认 SQLite（开发轻量，数据持久化到 ./server/data 目录）
DATABASE_URL="file:./data/dev.db"

# ----- PostgreSQL 配置（生产推荐）-----
# 1. 取消下方注释，修改连接信息
# 2. 设置 PRISMA_SCHEMA 指向 PG 版本 schema
# 3. docker compose 里启用 postgres 服务（见 docker-compose.yml）
# 4. 重启服务，首次会自动 prisma db push 建表
#
# DATABASE_URL="postgresql://shiju:shiju_pass_2024@postgres:5432/shiju?schema=public"
# PRISMA_SCHEMA="prisma/schema.postgres.prisma"
#
# POSTGRES_USER=shiju
# POSTGRES_PASSWORD=shiju_pass_2024
# POSTGRES_DB=shiju

# ----- MySQL 配置（可选）-----
# MYSQL_ROOT_PASSWORD=shiju_root_2024
# MYSQL_PASSWORD=shiju_pass_2024
